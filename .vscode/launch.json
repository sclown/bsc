{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug bsc",
      "type": "lldb",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build"
    },
    {
      "name": "Debug bsc (debug preset)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bsc.app/Contents/MacOS/bsc",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (debug preset)"
    },
    {
      "name": "Debug bsc (release preset)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/release/bsc.app/Contents/MacOS/bsc",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (release preset)"
    }
  ]
}
